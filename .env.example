# Usuário local criado em Rocky, Debian, Ubuntu, Nginx e Metasploitable
LAB_USER=analista
LAB_PASS=Lab@2026!

# Senha do root nesses mesmos containers
ROOT_PASS=Root@2026!

# ---------------- OpenVAS (login web) ----------------
OPENVAS_USER=admin
OPENVAS_PASS=OpenVAS@2026!

# ---------------- Wazuh ----------------
WAZUH_VERSION=4.12.0
# Se mudar INDEXER_PASSWORD / DASHBOARD_PASSWORD, gere um novo hash
# em config/wazuh_indexer/internal_users.yml (veja README.md)
INDEXER_USERNAME=admin
INDEXER_PASSWORD=SecretPassword
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver
API_USERNAME=wazuh-wui
API_PASSWORD=MyS3cr37P450r.*-

# ---------------- Rede do lab ----------------
# Três primeiros octetos da sub-rede /24 (ex.: 10.200.50 -> 10.200.50.0/24)
# Se der "Pool overlaps", troque por outra faixa livre (ex.: 10.123.45)
LAB_NET=10.200.50

# ---------------- Portas no host ----------------
# O start_lab.sh troca automaticamente as que estiverem em uso
WAZUH_DASHBOARD_PORT=443
OPENVAS_PORT=9392
NGINX_PORT=8080
SSH_ROCKY_PORT=2221
SSH_DEBIAN_PORT=2222
SSH_UBUNTU_PORT=2223
WAZUH_API_PORT=55000
WAZUH_AGENT_PORT=1514
WAZUH_ENROLL_PORT=1515
WAZUH_SYSLOG_PORT=514
